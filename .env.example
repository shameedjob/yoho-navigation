# Copy to .env (gitignored) for `python -m web`. See web/config.py.
FLASK_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(32))"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
YOHO_DATA_KEYS=              # python -m storage.crypto
YOHO_STORE=memory            # firestore in production
FIREBASE_CREDENTIALS=        # path to service-account JSON; empty = Application Default Credentials
YOHO_MONTHLY_TOKEN_LIMIT=200000
YOHO_DEV=1

# --- calendar alerts (accounts/alerts.py; run: python -m scheduler.alerts_service) ---
YOHO_WEBHOOK_BASE_URL=       # public HTTPS origin Google can POST to, e.g. https://abc123.ngrok-free.app; empty = no push
YOHO_SNS_TOPIC_ARN=          # arn:aws:sns:<region>:<account>:yoho-alerts; empty = alerts are only logged
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=           # or AWS_PROFILE; needs sns:Subscribe, sns:Publish on the topic
AWS_SECRET_ACCESS_KEY=
YOHO_ALERT_LEAD_MINUTES=60
